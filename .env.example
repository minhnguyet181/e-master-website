# Compose (thư mục gốc repo) — copy: cp .env.example .env
# Chỉ biến cho docker compose / build local. KHÔNG đặt JWT, GEMINI ở đây.

# MySQL container — phải khớp DB_PASS / DB_NAME trong deploy/env/backend.env (prod)
# hoặc Back-end/.env (dev local)
DB_PASS=change_me_strong_password
DB_NAME=e-master
MYSQL_HOST_PORT=3307

# Build FE local (docker compose build / npm không dùng file này cho runtime)
REACT_APP_BACKEND_URL=/e-master
REACT_APP_GOOGLE_CLIENT_ID=

# Production pull images (server 161.248.147.104 / https://e-master.id.vn)
DOCKER_REGISTRY=ghcr.io/YOUR_GITHUB_USER
IMAGE_TAG=latest
FRONTEND_URL=https://e-master.id.vn
