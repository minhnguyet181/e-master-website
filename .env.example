# Copy to `.env` bên cạnh docker-compose.yml khi cần override.
# Docker Compose đọc biến này khi build frontend.

# Dev local (trình duyệt gọi API trên máy):
# REACT_APP_BACKEND_URL=http://localhost:1818/e-master

# Production (mặc định trong docker-compose nếu không set):
# REACT_APP_BACKEND_URL=https://e-master.id.vn/e-master

REACT_APP_GOOGLE_CLIENT_ID=
MYSQL_HOST_PORT=3307
