# Đặt file `.env` cạnh docker-compose.yml (thư mục gốc repo sau khi cd e-master-website).
# Compose đọc file này để nội suy ${VAR} trong docker-compose.yml (MySQL, port, build args).

# Mật khẩu root MySQL + tên DB — phải khớp DB_PASS / DB_NAME trong Back-end/.env khi chạy stack
DB_PASS=change_me
DB_NAME=e-master

# Bắt buộc cho production build frontend (trình duyệt gọi API đúng origin):
# REACT_APP_BACKEND_URL=https://e-master.id.vn/e-master
# Hoặc same-origin: REACT_APP_BACKEND_URL=/e-master
REACT_APP_BACKEND_URL=http://localhost:1818/e-master

REACT_APP_GOOGLE_CLIENT_ID=

MYSQL_HOST_PORT=3307

# docker-compose.prod.yml — image GHCR:
# DOCKER_REGISTRY=ghcr.io/<owner>
# IMAGE_TAG=latest
# FRONTEND_URL=https://e-master.id.vn
