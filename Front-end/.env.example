# Local: npm start dùng .env.development → REACT_APP_BACKEND_URL=/e-master + proxy
# (copy thành .env.local nếu cần override)
# Nếu không dùng proxy, gọi API trực tiếp:
# REACT_APP_BACKEND_URL=http://localhost:1818/e-master
# Production: xem .env.production (https://e-master.id.vn/e-master)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id
