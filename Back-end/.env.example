# ── Database (MySQL local) ────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=moon123
# Docker Compose map MySQL ra host: 3307 -> 3306 (xem docker-compose.yml)
DB_PORT=3307
DB_NAME=e-master

# ── Server ────────────────────────────────────────────────────────
PORT=1818
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=mywebsite_secret_key
JWT_EXPIRES_IN=7d

# ── AI Services ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
HF_TOKEN=your_huggingface_token
NO_AI_IMPORT=false
# Admin PDF → resource JSON: mặc định dùng pdf-parse (không AI). Đặt true để bật lại luồng LLM cũ.
RESOURCE_PARSE_USE_AI=false

# ── Grading Cache ─────────────────────────────────────────────────
GRADING_CACHE_TTL_DAYS=30

# ── AI cache & rate limiting ──────────────────────────────────────
AI_CACHE_TTL_MINUTES=60
AI_RATE_LIMIT_MAX=40
ONBOARDING_AI_RATE_LIMIT_MAX=10
GRADING_RATE_LIMIT_MAX=30

# ── Misc ──────────────────────────────────────────────────────────
DB_SYNC=false
