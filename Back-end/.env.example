# ── Database (MySQL local) ────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=moon123
# Docker Compose map MySQL ra host: 3307 -> 3306 (xem docker-compose.yml)
DB_PORT=3307
DB_NAME=e-master

PORT=1818
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

JWT_SECRET=mywebsite_secret_key
JWT_EXPIRES_IN=7d

# ── Google Gemini (Generative Language API, API key từ GCP / AI Studio) ──
# URL do code ghép: .../GEMINI_API_VERSION/models/GEMINI_MODEL:generateContent
# GCP: bật "Generative Language API"; Credentials → API key (vd. gemini-api-key).
GEMINI_API_KEY=
# v1 = ổn định (khuyến nghị production: chat, chấm điểm, import). v1beta / v1alpha nếu cần model preview.
GEMINI_API_VERSION=v1
# Model id phải khả dụng với phiên bản API đã chọn (xem Google AI Studio → model).
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=

HF_TOKEN=your_huggingface_token
NO_AI_IMPORT=false
# Admin PDF → resource JSON: mặc định dùng pdf-parse (không AI). Đặt true để bật lại luồng LLM cũ.
RESOURCE_PARSE_USE_AI=false

# ── Queue (BullMQ) — Docker: REDIS_URL=redis://redis:6379 ──────────
QUEUE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# ── Grading Cache ─────────────────────────────────────────────────
GRADING_CACHE_TTL_DAYS=30

# ── AI cache & rate limiting ────────────────────────────────────────
AI_CACHE_TTL_MINUTES=60
AI_RATE_LIMIT_MAX=40
ONBOARDING_AI_RATE_LIMIT_MAX=10
GRADING_RATE_LIMIT_MAX=30

# ── Misc ──────────────────────────────────────────────────────────
DB_SYNC=false
