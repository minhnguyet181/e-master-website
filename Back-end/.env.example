# Dev local: cp Back-end/.env.example Back-end/.env
# Production server: dùng deploy/env/backend.env (xem deploy/README.md)
#
# MySQL Docker: DB_PASS / DB_NAME phải khớp file .env ở thư mục gốc repo.

DB_HOST=localhost
DB_USER=root
DB_PASS=change_me
DB_PORT=3307
DB_NAME=e-master

PORT=1818
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

JWT_SECRET=change_to_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=
GEMINI_API_VERSION=v1
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

HF_TOKEN=

NO_AI_IMPORT=false
RESOURCE_PARSE_USE_AI=false

QUEUE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
GRADING_QUEUE_CONCURRENCY=2
IMPORT_QUEUE_CONCURRENCY=1

GRADING_CACHE_TTL_DAYS=30
AI_CACHE_TTL_MINUTES=60
AI_RATE_LIMIT_MAX=40
ONBOARDING_AI_RATE_LIMIT_MAX=10
GRADING_RATE_LIMIT_MAX=30

JSON_BODY_LIMIT=15mb
DB_SYNC=false
DB_QUERY_LOG=false
DB_SLOW_QUERY_MS=200
SLOW_OPERATION_MS=200
