# ═══════════════════════════════════════════════════════════════════
# Sao chép: cp Back-end/.env.example Back-end/.env  (từ thư mục gốc repo,
# ví dụ: cd e-master-website)
#
# Docker Compose nội suy MYSQL_ROOT_PASSWORD từ file .env ở THƯ MỤC GỐC repo
# (không đọc Back-end/.env). Giữ DB_PASS và DB_NAME khớp giữa hai file.
# ═══════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────
# Chạy node trên máy host + MySQL Docker map 3307→3306:
DB_HOST=localhost
DB_USER=root
DB_PASS=change_me
DB_PORT=3307
DB_NAME=e-master
# Trong container backend (docker-compose): DB_HOST/DB_PORT được ghi đè → mysql:3306

# ── Server ─────────────────────────────────────────────────────────
PORT=1818
# Production: URL công khai của frontend (CORS). Ví dụ https://e-master.id.vn
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── Auth ───────────────────────────────────────────────────────────
JWT_SECRET=change_to_long_random_string
JWT_EXPIRES_IN=7d

# ── Google Gemini ──────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyD9qx4gM1a5q2K-C9pdRCpyte-eVMpvS8M
GEMINI_API_VERSION=v1
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

HF_TOKEN=

# Import / admin PDF (đặt true để tắt AI trong một số luồng)
NO_AI_IMPORT=false
RESOURCE_PARSE_USE_AI=false

# ── Queue (BullMQ) — cần service Redis nếu QUEUE_ENABLED=true ───────
QUEUE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
GRADING_QUEUE_CONCURRENCY=2
IMPORT_QUEUE_CONCURRENCY=1

# ── Cache & rate limits ────────────────────────────────────────────
GRADING_CACHE_TTL_DAYS=30
AI_CACHE_TTL_MINUTES=60
AI_RATE_LIMIT_MAX=40
ONBOARDING_AI_RATE_LIMIT_MAX=10
GRADING_RATE_LIMIT_MAX=30

# ── HTTP / DB debug (tùy chọn) ─────────────────────────────────────
JSON_BODY_LIMIT=15mb
DB_SYNC=false
DB_QUERY_LOG=false
DB_SLOW_QUERY_MS=200
SLOW_OPERATION_MS=200
