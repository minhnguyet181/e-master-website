# ── Database (MySQL) ──────────────────────────────────────────────
DB_HOST=localhost          # docker: mysql (tên service)
DB_USER=root
DB_PASS=moon123
# Local dev: nếu MySQL chạy bằng docker-compose, cổng host thường là 3307 (MYSQL_HOST_PORT)
DB_PORT=3307
DB_NAME=e-master

# ── Server ────────────────────────────────────────────────────────
PORT=1818
# Production (CORS): https://e-master.id.vn — local dev: http://localhost:3000
FRONTEND_URL=https://e-master.id.vn
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=your_strong_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# ── AI Services ───────────────────────────────────────────────────
# Gemini: https://aistudio.google.com/apikey — chỉ dán chuỗi key (dạng AIza...), KHÔNG thêm https://, KHÔNG ngoặc kép
GEMINI_API_KEY=
# Tuỳ chọn: model (mặc định gemini-1.5-flash). Ví dụ: GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL=gemini-1.5-flashAIzaSyD9qx4gM1a5q2K-C9pdRCpyte-eVMpvS8M
OPENAI_API_KEY=your_openai_key
HF_TOKEN=your_huggingface_token

# ── Grading Cache ─────────────────────────────────────────────────
GRADING_CACHE_TTL_DAYS=30

# ── Misc ──────────────────────────────────────────────────────────
DB_SYNC=false
