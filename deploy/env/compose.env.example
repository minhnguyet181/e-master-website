# Copy trên server: cp deploy/env/compose.env.example deploy/env/compose.env
# Dùng cho: docker compose --env-file deploy/env/compose.env -f docker-compose.prod.yml

DB_PASS=change_me_strong_password
DB_NAME=e-master

DOCKER_REGISTRY=ghcr.io/YOUR_GITHUB_USER
IMAGE_TAG=latest
FRONTEND_URL=https://e-master.id.vn

# Cổng publish container frontend (host nginx proxy vào đây)
HTTP_PORT=80
