# Copy trên server: cp deploy/env/compose.env.example deploy/env/compose.env
# Dùng cho: docker compose --env-file deploy/env/compose.env -f docker-compose.prod.yml

DB_PASS=change_me_strong_password
DB_NAME=e-master

DOCKER_REGISTRY=ghcr.io/minhnguyet181
IMAGE_TAG=latest
FRONTEND_URL=https://e-master.id.vn

# Map ra host — dùng 8080 khi host nginx đã chiếm :80/:443
HTTP_PORT=8080

# Nếu pull mysql:8.0 từ Docker Hub timeout (TLS handshake), dùng mirror:
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
