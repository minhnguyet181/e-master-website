# Copy trên server: cp deploy/env/backend.env.example deploy/env/backend.env
# Phải khớp DB_PASS / DB_NAME với deploy/env/compose.env

# ── Database (trong Docker network) ───────────────────────────────
DB_HOST=mysql
DB_USER=root
DB_PASS=change_me_strong_password
DB_PORT=3306
DB_NAME=e-master

# ── Server ─────────────────────────────────────────────────────────
PORT=1818
NODE_ENV=production
FRONTEND_URL=https://e-master.id.vn

# ── Auth (bắt buộc — dùng chuỗi ngẫu nhiên ≥ 32 ký tự) ───────────
JWT_SECRET=change_to_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ── Google OAuth (FE build-time; backend chỉ cần nếu verify server-side) ─
# REACT_APP_GOOGLE_CLIENT_ID đặt trong CI secret / build-arg, không bắt buộc ở đây

# ── Gemini / OpenAI ────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_API_VERSION=v1
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

HF_TOKEN=

# ── Import / admin ─────────────────────────────────────────────────
NO_AI_IMPORT=true
RESOURCE_PARSE_USE_AI=false

# ── Queue (false = không cần Redis container) ─────────────────────
QUEUE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# ── Cache & rate limits ────────────────────────────────────────────
GRADING_CACHE_TTL_DAYS=30
AI_CACHE_TTL_MINUTES=60
AI_RATE_LIMIT_MAX=40
ONBOARDING_AI_RATE_LIMIT_MAX=10
GRADING_RATE_LIMIT_MAX=30

# ── HTTP / DB ─────────────────────────────────────────────────────
JSON_BODY_LIMIT=15mb
DB_SYNC=false
DB_QUERY_LOG=false
